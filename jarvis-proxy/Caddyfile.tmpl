# Jarvis HTTPS reverse proxy for tailnet dev previews.
#
# This file is a TEMPLATE. `__HOST__` is replaced by `install/55-jarvis-proxy.sh`
# at install time using the value of `tailscale status --json | .Self.DNSName`.
# Edit the template here, never the rendered /etc/caddy/Caddyfile directly.
#
# Convention: each dev service's HTTPS port = local port + 10000. See PORTS.md.

{
	auto_https off
	# Admin API bound to localhost only — required for `caddy reload` to push
	# new config to the running daemon. Not exposed to the tailnet because the
	# ufw default-deny + Hetzner firewall both block public access; only shell
	# users on jarvis can reach it.
	admin localhost:2019
}

(tls_jarvis) {
	tls /var/lib/caddy/jarvis.crt /var/lib/caddy/jarvis.key
}

# ───────── labelit ─────────
__HOST__:14070 {
	import tls_jarvis
	reverse_proxy 127.0.0.1:4070
}

__HOST__:14071 {
	import tls_jarvis
	reverse_proxy 127.0.0.1:4071
}

__HOST__:14080 {
	import tls_jarvis
	reverse_proxy 127.0.0.1:4080
}

